PICARX_HOST=0.0.0.0
PICARX_PORT=8080
# Optional HTTPS for browser microphone access over a LAN hostname.
# HTTPS is only enabled when PICARX_HTTPS_ENABLE=true and both files exist.
PICARX_HTTPS_ENABLE=false
PICARX_SSL_CERTFILE=
PICARX_SSL_KEYFILE=
PICARX_STATE_DIR=./state
PICARX_USE_MOCK=false
PICARX_HARDWARE_INIT_MODE=direct
PICARX_CAMERA_FORCE_BACKEND=picamera2
PICARX_CAMERA_FORMAT=RGB888
PICARX_CAMERA_COLOR_FIX=auto
PICARX_CAMERA_JPEG_ENCODER=auto
PICARX_CAMERA_WIDTH=640
PICARX_CAMERA_HEIGHT=480
PICARX_CAMERA_FULL_FOV=true
PICARX_CAMERA_DISABLE_SCALER_CROP=true
PICARX_CAMERA_AWB_ENABLE=true
PICARX_CAMERA_AWB_MODE=auto
PICARX_VOICE_CAPTURE_MAX_SECONDS=20
PICARX_MAX_SPEED=50
PICARX_STEERING_LIMIT=30
PICARX_PAN_LIMIT=70
PICARX_TILT_UP_LIMIT=35
PICARX_TILT_DOWN_LIMIT=-35
PICARX_OBSTACLE_STOP_CM=18
PICARX_DRIVE_WATCHDOG_SECONDS=0.9
PICARX_GREET_COOLDOWN_SECONDS=20
PICARX_TRACKING_STEP_DEGREES=5
PICARX_TRACKING_DEADBAND_PX=36
# Optional bearer token for REST and WebSocket access:
# PICARX_API_TOKEN=change-me
# Optional Gemini Live integration:
# GEMINI_API_KEY=AIza...
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_NATIVE_AUDIO_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
